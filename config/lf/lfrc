# ── Options ──
set preview true
set hidden true
set drawbox true
set icons true
set ignorecase true
set scrolloff 5
set shell bash
set shellopts '-eu'
set ifs "\n"

# ── Vim keybinds ──
map <enter> open
map D delete
map x cut
map y copy
map p paste
map r rename
map . set hidden!
map R reload
map q quit

# ── Open files ──
cmd open ${{
    case $(file --mime-type "$f" -bL) in
        text/*|application/json) $EDITOR "$f" ;;
        image/*) imv "$f" ;;
        video/*|audio/*) mpv "$f" ;;
        application/pdf) zathura "$f" ;;
        *) xdg-open "$f" ;;
    esac
}}

# ── Create directory ──
cmd mkdir %{{
    printf "Name: "
    read name
    mkdir -p "$name"
}}
map a mkdir

# ── Create file ──
cmd mkfile %{{
    printf "Name: "
    read name
    touch "$name"
}}
map A mkfile
