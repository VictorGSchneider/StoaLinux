;; ╔══════════════════════════════════════════════════════════════╗
;; ║  STOA LINUX — Memento Mori Widget (eww)                     ║
;; ║  "Remember that you will die." — Stoic tradition             ║
;; ╚══════════════════════════════════════════════════════════════╝

;; ── Variables (data from JSON script) ──
(defpoll memento-data :interval "1200s"
  `~/.local/bin/stoa-memento-data`)

;; ── Main widget ──
(defwidget memento-mori []
  (box :class "memento-container"
       :orientation "v"
       :space-evenly false
    ;; Header
    (box :class "memento-header"
         :orientation "v"
         :space-evenly false
      (label :class "header-title" :text "MEMENTO MORI")
      (label :class "header-subtitle"
             :text "Remember that you will die."))

    ;; Stats
    (box :class "memento-stats"
         :orientation "h"
         :space-evenly true
      (box :class "stat-box" :orientation "v"
        (label :class "stat-value"
               :text {memento-data != "" ? jq(memento-data, ".days_lived") : "—"})
        (label :class "stat-label" :text "days lived"))
      (box :class "stat-box" :orientation "v"
        (label :class "stat-value"
               :text {memento-data != "" ? jq(memento-data, ".weeks_lived") : "—"})
        (label :class "stat-label" :text "weeks lived"))
      (box :class "stat-box" :orientation "v"
        (label :class "stat-value"
               :text {memento-data != "" ? jq(memento-data, ".years_lived") : "—"})
        (label :class "stat-label" :text "years lived")))

    ;; Year progress
    (box :class "memento-year"
         :orientation "v"
         :space-evenly false
      (label :class "year-label"
             :text {memento-data != "" ?
               "Year ${jq(memento-data, '.current_year')} — ${jq(memento-data, '.year_pct')}%" :
               "Year — %"})
      (progress :class "year-bar"
                :value {memento-data != "" ? jq(memento-data, ".year_pct") : 0}))

    ;; Weeks grid info
    (box :class "memento-weeks"
         :orientation "v"
         :space-evenly false
      (label :class "weeks-info"
             :text {memento-data != "" ?
               "${jq(memento-data, '.weeks_lived')} of ${jq(memento-data, '.total_weeks')} weeks" :
               "— of — weeks"})
      (label :class "weeks-sub"
             :text {memento-data != "" ?
               "Life expectancy: ${jq(memento-data, '.life_years')} years" :
               "Life expectancy: — years"}))

    ;; Quote
    (box :class "memento-quote"
         :orientation "v"
      (label :class "quote-text"
             :text {memento-data != "" ? jq(memento-data, ".quote") : "…"}
             :wrap true))

    ;; Footer
    (box :class "memento-footer"
      (label :class "footer-text"
             :text {memento-data != "" ?
               "${jq(memento-data, '.today')}" : "—"}))))

;; ── Window ──
(defwindow memento
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "860px"
                      :height "580px"
                      :anchor "center")
  :stacking "overlay"
  :focusable false   ;
  (memento-mori))

;; ══════════════════════════════════════════════════════════════
;; ║  CAPTURE — Screenshot + Recording toolbar                  ║
;; ══════════════════════════════════════════════════════════════

;; ── Capture variables ──
(defvar capture-mode "screen")
(defvar capture-type "screenshot")
(defvar capture-delay 0)

;; ── Mode button ──
(defwidget capture-mode-btn [mode icon label]
  (button :class {capture-mode == mode ? "cap-mode-btn active" : "cap-mode-btn"}
          :onclick "eww update capture-mode=${mode}"
    (box :orientation "v" :space-evenly false
      (label :class "cap-mode-icon" :text icon)
      (label :class "cap-mode-label" :text label))))

;; ── Main capture widget ──
(defwidget capture-bar []
  (box :class "cap-container" :orientation "v" :space-evenly false

    ;; Close button (top-right)
    (box :class "cap-close-row" :halign "end"
      (button :class "cap-close-btn"
              :onclick "eww close capture"
        (label :text "✕")))

    ;; Mode selection row
    (box :class "cap-modes" :orientation "h" :space-evenly true :halign "center"
      (capture-mode-btn :mode "selection" :icon "⊡" :label "Selection")
      (capture-mode-btn :mode "screen"    :icon "▣" :label "Screen")
      (capture-mode-btn :mode "window"    :icon "☐" :label "Window"))

    ;; Divider
    (box :class "cap-divider")

    ;; Actions row
    (box :class "cap-actions" :orientation "h" :space-evenly false :halign "center"

      ;; Type toggle (screenshot / recording)
      (box :class "cap-type-toggle" :orientation "h" :space-evenly false
        (button :class {capture-type == "screenshot" ? "cap-type-btn active" : "cap-type-btn"}
                :onclick "eww update capture-type=screenshot"
          (label :text "📷"))
        (button :class {capture-type == "recording" ? "cap-type-btn active" : "cap-type-btn"}
                :onclick "eww update capture-type=recording"
          (label :text "🎥")))

      ;; Capture button
      (button :class {capture-type == "screenshot" ? "cap-shutter-btn" : "cap-shutter-btn recording"}
              :onclick "(stoa-capture ${capture-mode} ${capture-type} ${capture-delay} </dev/null >/dev/null 2>&1 &)"
        (label :class "cap-shutter-icon"
               :text {capture-type == "screenshot" ? "●" : "●"}))

      ;; Delay selector (screenshot only)
      (box :class "cap-delay" :orientation "h" :space-evenly false
           :visible {capture-type == "screenshot"}
        (button :class {capture-delay == 0 ? "cap-delay-btn active" : "cap-delay-btn"}
                :onclick "eww update capture-delay=0"
          (label :text "0s"))
        (button :class {capture-delay == 3 ? "cap-delay-btn active" : "cap-delay-btn"}
                :onclick "eww update capture-delay=3"
          (label :text "3s"))
        (button :class {capture-delay == 5 ? "cap-delay-btn active" : "cap-delay-btn"}
                :onclick "eww update capture-delay=5"
          (label :text "5s"))))))

;; ── Capture window ──
(defwindow capture
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "120px"
                      :width "380px"
                      :height "220px"
                      :anchor "bottom center")
  :stacking "overlay"
  :focusable true
  (capture-bar))

;; ══════════════════════════════════════════════════════════════
;; ║  PREDICT — Text Prediction + Emoji Suggestions             ║
;; ══════════════════════════════════════════════════════════════

;; ── Predict variables ──
(defvar predict-data '{"prefix":"","words":[],"emojis":[],"visible":false}')

;; ── Indexed word button (shows only if word exists at index) ──
(defwidget pred-word [idx]
  (button :class {idx == 0 ? "pred-word-btn first" : "pred-word-btn"}
          :visible {arraylength(jq(predict-data, ".words")) > idx}
          :onclick "stoa-predict select ${idx}"
    (label :text {arraylength(jq(predict-data, ".words")) > idx ?
                  jq(predict-data, ".words[${idx}]") : ""})))

;; ── Indexed emoji button ──
(defwidget pred-emoji [idx]
  (button :class "pred-emoji-btn"
          :visible {arraylength(jq(predict-data, ".emojis")) > idx}
          :onclick "stoa-predict select-emoji ${idx}"
          :tooltip {arraylength(jq(predict-data, ".emojis")) > idx ?
                    jq(predict-data, ".emojis[${idx}].name") : ""}
    (label :text {arraylength(jq(predict-data, ".emojis")) > idx ?
                  jq(predict-data, ".emojis[${idx}].emoji") : ""})))

;; ── Main predict widget ──
(defwidget predict-bar []
  (box :class "pred-container"
       :orientation "h"
       :space-evenly false
       :visible {jq(predict-data, ".visible")}

    ;; Word suggestions (up to 5)
    (box :class "pred-words" :orientation "h" :space-evenly false
      (pred-word :idx 0)
      (pred-word :idx 1)
      (pred-word :idx 2)
      (pred-word :idx 3)
      (pred-word :idx 4))

    ;; Divider
    (box :class "pred-divider"
         :visible {arraylength(jq(predict-data, ".words")) > 0 &&
                   arraylength(jq(predict-data, ".emojis")) > 0})

    ;; Emoji suggestions (up to 3)
    (box :class "pred-emojis" :orientation "h" :space-evenly false
      (pred-emoji :idx 0)
      (pred-emoji :idx 1)
      (pred-emoji :idx 2))))

;; ── Predict window ──
(defwindow predict
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "-60px"
                      :width "420px"
                      :height "44px"
                      :anchor "bottom center")
  :stacking "overlay"
  :focusable false
  (predict-bar))
