  ║  "The tools of virtue are always at hand." — Seneca         ║
  ╚══════════════════════════════════════════════════════════════╝
-->
<actions>

<action>
	<icon>applications-utilities</icon>
	<name>Stoatools</name>
	<submenu></submenu>
	<unique-id>stoatools-menu</unique-id>
	<command>~/.local/bin/stoa-thunar %F</command>
	<description>Open Stoatools menu (resize, rename, OCR, locksmith, archive)</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>kitty</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1778890416598063-1</unique-id>
	<command>kitty --directory=%f</command>
	<description>Open Terminal Here</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<!-- ── Cloud Drive (only meaningful under ~/Drive/) ── -->

<action>
	<icon>emblem-downloads</icon>
	<name>Make Available Offline</name>
	<submenu></submenu>
	<unique-id>stoa-drive-pin-1</unique-id>
	<command>~/.local/bin/stoa-drive-pin %F</command>
	<description>Download to local VFS cache for offline access. Green ✓ emblem appears when done.</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>emblem-synchronizing</icon>
	<name>Remove Offline Copy</name>
	<submenu></submenu>
	<unique-id>stoa-drive-unpin-1</unique-id>
	<command>~/.local/bin/stoa-drive-unpin %F</command>
	<description>Remove from local cache; file will stream from cloud on next access.</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>emblem-ok</icon>
	<name>Sync Drive Emblems</name>
	<submenu></submenu>
	<unique-id>stoa-drive-emblems-1</unique-id>
	<command>bash -c 'r="${1#$HOME/Drive/}"; ~/.local/bin/stoa-drive-emblems "${r%%/*}"' - %f</command>
	<description>Refresh ✓ / streaming emblems for this drive based on current VFS cache.</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

</actions>
