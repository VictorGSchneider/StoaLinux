<actions>

<!-- ── Stoatools (grouped under one native flyout submenu, no rofi) ── -->

<action>
	<icon>document-edit</icon>
	<name>Rename…</name>
	<submenu>Stoatools</submenu>
	<unique-id>stoa-rename-menu</unique-id>
	<command>~/.local/bin/stoa-rename %F</command>
	<description>Batch rename with regex</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>system-lock-screen</icon>
	<name>Locksmith</name>
	<submenu>Stoatools</submenu>
	<unique-id>stoa-locksmith-menu</unique-id>
	<command>~/.local/bin/stoa-locksmith %F</command>
	<description>See what's locking these files/folders</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>package-x-generic</icon>
	<name>Compress…</name>
	<submenu>Stoatools</submenu>
	<unique-id>stoa-archive-compress-menu</unique-id>
	<command>~/.local/bin/stoa-archive %F</command>
	<description>Compress selection into zip/tar.gz/tar.xz/7z</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>archive-extract</icon>
	<name>Extract Archive</name>
	<submenu>Stoatools</submenu>
	<unique-id>stoa-archive-extract-menu</unique-id>
	<command>~/.local/bin/stoa-archive %F</command>
	<description>Extract these archive(s)</description>
	<range></range>
	<patterns>*.zip;*.tar;*.tar.gz;*.tgz;*.tar.bz2;*.tbz2;*.tbz;*.tar.xz;*.txz;*.7z;*.rar</patterns>
	<other-files/>
</action>

<action>
	<icon>image-x-generic</icon>
	<name>Resize Image…</name>
	<submenu>Stoatools</submenu>
	<unique-id>stoa-resize-menu</unique-id>
	<command>~/.local/bin/stoa-resize %F</command>
	<description>Batch resize images with presets</description>
	<range></range>
	<patterns>*</patterns>
	<image-files/>
</action>

<action>
	<icon>accessories-text-editor</icon>
	<name>Extract Text (OCR)</name>
	<submenu>Stoatools</submenu>
	<unique-id>stoa-ocr-menu</unique-id>
	<command>~/.local/bin/stoa-ocr %f</command>
	<description>Extract text from image (OCR)</description>
	<range>1</range>
	<patterns>*</patterns>
	<image-files/>
</action>

<action>
	<icon>kitty</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1778890416598063-1</unique-id>
	<command>kitty --directory=%f</command>
	<description>Open Terminal Here</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<!-- ── Cloud Drive (only meaningful under ~/Drive/) ── -->

<action>
	<icon>emblem-downloads</icon>
	<name>Make Available Offline</name>
	<submenu></submenu>
	<unique-id>stoa-drive-pin-1</unique-id>
	<command>~/.local/bin/stoa-drive-pin %F</command>
	<description>Download to local VFS cache for offline access. Green ✓ emblem appears when done.</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>emblem-synchronizing</icon>
	<name>Remove Offline Copy</name>
	<submenu></submenu>
	<unique-id>stoa-drive-unpin-1</unique-id>
	<command>~/.local/bin/stoa-drive-unpin %F</command>
	<description>Remove from local cache; file will stream from cloud on next access.</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

<action>
	<icon>emblem-ok</icon>
	<name>Sync Drive Emblems</name>
	<submenu></submenu>
	<unique-id>stoa-drive-emblems-1</unique-id>
	<command>bash -c 'r="${1#$HOME/Drive/}"; ~/.local/bin/stoa-drive-emblems "${r%%/*}"' - %f</command>
	<description>Refresh ✓ / streaming emblems for this drive based on current VFS cache.</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

</actions>
