# ╔══════════════════════════════════════════════════════════════╗
# ║  STOA LINUX — i3wm                                          ║
# ║  "Order is the first law of heaven." — Marcus Aurelius       ║
# ╚══════════════════════════════════════════════════════════════╝

set $mod Mod4

# ── Fonts ──
font pango:EB Garamond, Font Awesome 6 Free 11

# ── Stoic Palette ──
set $bg         #211e19
set $bg_light   #2d2921
set $fg         #d4cfc4
set $fg_dim     #a89f91
set $bronze     #c49a5c
set $gold       #d4a84b
set $olive      #8a9a6c
set $terracotta #b36b5a
set $stone      #6e6a62
set $parchment  #c4b08a
set $azure      #5a7a8a

# ── Window Colors ──
# class                 border      bg          text        indicator   child_border
client.focused          $bronze     $bg_light   $fg         $gold       $bronze
client.focused_inactive $stone      $bg         $fg_dim     $stone      $stone
client.unfocused        $bg         $bg         $fg_dim     $bg         $bg
client.urgent           $terracotta $terracotta $fg         $terracotta $terracotta
client.placeholder      $bg         $bg         $fg_dim     $bg         $bg
client.background       $bg

# ── Borders ──
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 6
smart_gaps on

# ── Bar ──
bar {
    status_command i3status -c ~/.config/i3/i3status.conf
    position top
    separator_symbol "  │  "

    colors {
        background $bg
        statusline $fg
        separator  $stone

        # class            border      bg          text
        focused_workspace  $bronze     $bg_light   $fg
        active_workspace   $stone      $bg         $fg_dim
        inactive_workspace $bg         $bg         $fg_dim
        urgent_workspace   $terracotta $terracotta $fg
        binding_mode       $gold       $bg_light   $fg
    }
}

# ── Core Keybinds ──
bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id rofi -show drun -config ~/.config/rofi/config.rasi
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Ctrl+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# ── Apps ──
bindsym $mod+a exec --no-startup-id ~/.local/bin/stoa-store
bindsym $mod+b exec brave
bindsym $mod+c exec qalculate-gtk
bindsym $mod+n exec alacritty -e btop
bindsym $mod+o exec obsidian
bindsym $mod+m exec ~/.local/bin/stoa-memento
bindsym $mod+i exec --no-startup-id ~/.local/bin/stoa-settings
bindsym $mod+slash exec ~/.local/bin/stoa-keybinds-toggle

# ── Lock Screen ──
bindsym $mod+Escape exec --no-startup-id i3lock --blur 5 --ring-color=c49a5c --inside-color=211e19cc --line-uses-inside --keyhl-color=8a9a6c --bshl-color=b36b5a --separator-color=6e6a62 --time-color=c49a5c --date-color=d4cfc4aa --verif-color=8a9a6c --wrong-color=b36b5a --clock --time-str="%H:%M" --date-str="%A, %d %B" --time-font="JetBrains Mono" --date-font="JetBrains Mono"

# ── Navigation ──
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ── Layout ──
bindsym $mod+g splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+e exec alacritty -e lf
bindsym $mod+Shift+e exec thunar
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+p focus parent

# ── Workspaces (Roman numerals) ──
set $ws1 "I"
set $ws2 "II"
set $ws3 "III"
set $ws4 "IV"
set $ws5 "V"
set $ws6 "VI"
set $ws7 "VII"
set $ws8 "VIII"
set $ws9 "IX"
set $ws10 "X"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# ── Resize ──
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ── Volume (via stoa-osd) ──
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/stoa-osd volume-up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/stoa-osd volume-down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/stoa-osd volume-mute

# ── Brightness (via stoa-osd) ──
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/stoa-osd brightness-up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/stoa-osd brightness-down

# ── Screenshot ──
bindsym Print exec --no-startup-id maim ~/Pictures/screenshots/screenshot-$(date +%s).png
bindsym $mod+Print exec --no-startup-id maim -s ~/Pictures/screenshots/screenshot-$(date +%s).png

# ── Clipboard ──
bindsym $mod+v exec --no-startup-id ~/.local/bin/stoa-clipboard show
bindsym $mod+Shift+v exec --no-startup-id ~/.local/bin/stoa-clipboard pin

# ── Stoatools ──
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/stoa-ocr
bindsym $mod+Shift+p exec --no-startup-id ~/.local/bin/stoa-paste

# ── CapsLock / NumLock ──
bindsym --release Caps_Lock exec --no-startup-id ~/.local/bin/stoa-osd capslock
bindsym --release Num_Lock exec --no-startup-id ~/.local/bin/stoa-osd numlock

# ── Autostart ──
exec_always --no-startup-id pkill picom; picom --config ~/.config/picom/picom.conf -b
exec_always --no-startup-id feh --bg-fill ~/.config/stoa/wallpapers/marble.png
exec --no-startup-id dunst -config ~/.config/dunst/dunstrc

# ── Qalculate ──
for_window [class="Qalculate-gtk"] floating enable, resize set 420 540, move position center

# ── Steam ──
for_window [class="steam" title="Friends List"] floating enable
for_window [class="steam" title="Steam Settings"] floating enable
assign [class="steam" title="Steam"] $ws9

# ── eww Memento Mori ──
for_window [title="memento"] floating enable, resize set 860 580, move position center
