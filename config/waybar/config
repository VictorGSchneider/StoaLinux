{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/keybinds", "hyprland/window"],
    "modules-right": [
        "custom/keybinds-info",
        "custom/clipboard",
        "disk",
        "network",
        "battery",
        "cpu",
        "memory",
        "wireplumber",
        "clock"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
        },
        "persistent-workspaces": {
            "*": 10
        }
    },

    "disk": {
        "format": " {free}",
        "path": "/"
    },

    "network": {
        "format-wifi": " {essid} {signalStrength}%",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": " --",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5
    },

    "memory": {
        "format": " {used:0.1f}G / {total:0.1f}G",
        "interval": 5
    },

    "wireplumber": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "~/.local/bin/stoa-osd volume-up",
        "on-scroll-down": "~/.local/bin/stoa-osd volume-down"
    },

    "clock": {
        "format": " {:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/keybinds": {
        "exec": "~/.local/bin/stoa-keybinds-bar bar",
        "return-type": "json",
        "interval": 5,
        "tooltip": true
    },

    "custom/keybinds-info": {
        "exec": "~/.local/bin/stoa-keybinds-bar info",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "on-click": "~/.local/bin/stoa-keybinds-toggle"
    },

    "custom/clipboard": {
        "format": "",
        "tooltip-format": "Clipboard (Super+V) │ Fixar (Super+Shift+V)",
        "on-click": "~/.local/bin/stoa-clipboard show",
        "on-click-right": "~/.local/bin/stoa-clipboard pin",
        "interval": "once"
    },

    "hyprland/window": {
        "format": "{class}~{title}",
        "separate-outputs": true,
        "rewrite": {
            "brave-browser~(.*)": "Super+B │ $1",
            "obsidian~(.*)": "Super+O │ $1",
            "kitty~.*btop.*": "Super+N │ btop",
            "kitty~.*lf.*": "Super+E │ lf",
            "kitty~(.*)": "Super+⏎ │ $1",
            "org.pwmt.zathura~(.*)": "$1",
            "mpv~(.*)": "$1",
            "imv~(.*)": "$1",
            "(.*)~(.*)": "$2",
            "": ""
        }
    }
}
