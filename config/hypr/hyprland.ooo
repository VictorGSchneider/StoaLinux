--[[ -- ╔══════════════════════════════════════════════════════════════╗
-- ║  STOA LINUX — Hyprland (Lua)                               ║
-- ║  "Order is the first law of heaven." — Marcus Aurelius      ║
-- ╚══════════════════════════════════════════════════════════════╝
 
-- ── Monitor ──
monitor = { "", preferred = true, auto = true, scale = 1 }
 
-- ── Autostart ──
exec_once = {
  "waybar",
  "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1",
  "swaybg -i ~/.config/stoa/wallpapers/marble.png -m fill",
  "wl-paste --watch cliphist store",
  "stoa-quotes-sync tick",
  "stoa-drive mount-all",
  "stoa-doctor",
  "wl-paste --type text --watch cliphist store",
  "wl-paste --type image --watch cliphist store",
}
 
-- ── Environment Variables ──
env = {
  XCURSOR_SIZE = 24,
  XCURSOR_THEME = "Colloid-cursors",
  QT_QPA_PLATFORM = "wayland",
  QT_QPA_PLATFORMTHEME = "qt5ct",
  QT_STYLE_OVERRIDE = "Fusion",
  QT_AUTO_SCREEN_SCALE_FACTOR = 1,
  GTK_THEME = "Adwaita:dark",
  ELECTRON_OZONE_PLATFORM_HINT = "auto",
  XDG_CURRENT_DESKTOP = "Hyprland",
  XDG_SESSION_TYPE = "wayland",
  XDG_SESSION_DESKTOP = "Hyprland",
}
 
-- ── Input ──
input = {
  kb_layout = "br",
  kb_variant = "abnt2",
  follow_mouse = 1,
  sensitivity = 0,
  touchpad = {
    natural_scroll = true,
  },
}
 
-- ── Stoic Palette ──
local colors = {
  bg         = "rgb(211e19)",
  bg_light   = "rgb(2d2921)",
  fg         = "rgb(d4cfc4)",
  fg_dim     = "rgb(a89f91)",
  bronze     = "rgb(c49a5c)",
  gold       = "rgb(d4a84b)",
  olive      = "rgb(8a9a6c)",
  terracotta = "rgb(b36b5a)",
  stone      = "rgb(6e6a62)",
}
 
-- ── Appearance ──
general = {
  gaps_in = 3,
  gaps_out = 6,
  border_size = 2,
  col = {
    active_border = colors.bronze,
    inactive_border = colors.bg_light,
  },
  layout = "dwindle",
}
 
decoration = {
  rounding = 4,
  blur = {
    enabled = true,
    size = 4,
    passes = 2,
  },
  shadow = {
    enabled = true,
    range = 12,
    offset = { -7, -7 },
    render_power = 3,
    color = "rgba(0a090880)",
  },
  inactive_opacity = 0.90,
  active_opacity = 1.0,
}
 
animations = {
  enabled = true,
  bezier = { stoa = "0.25, 0.8, 0.25, 1.0" },
  animation = {
    { "windows", 1, 4, "stoa" },
    { "windowsOut", 1, 4, "stoa popin 80%" },
    { "border", 1, 6, "default" },
    { "fade", 1, 4, "default" },
    { "workspaces", 1, 3, "stoa" },
  },
}
 
dwindle = {
  pseudotile = true,
  preserve_split = true,
}
 
misc = {
  force_default_wallpaper = 0,
  disable_hyprland_logo = true,
}
 
-- ── Keybinds ──
local mod = "SUPER"
 
-- Helper function to register keybinds
local function bind_key(mods, key, action, cmd)
  hl.bind(mods .. " + " .. key, function()
    hl.dispatch(action .. " " .. cmd)
  end)
end
 
-- Core binds
hl.bind(mod .. " + Return", function() hl.dispatch(hl.dsp.exec("kitty")) end)
hl.bind(mod .. " + D", function() hl.dispatch(hl.dsp.exec("qs -c noctalia-shell ipc call launcher toggle")) end)
hl.bind(mod .. " + Q", function() hl.dispatch(hl.dsp.killactive()) end)
hl.bind(mod .. " + F", function() hl.dispatch(hl.dsp.fullscreen(0)) end)
hl.bind(mod .. " + SHIFT + Space", function() hl.dispatch(hl.dsp.togglefloating()) end)
hl.bind(mod .. " + CTRL + E", function() hl.dispatch(hl.dsp.exit()) end)
 
-- Apps
hl.bind(mod .. " + A", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-store")) end)
hl.bind(mod .. " + B", function() hl.dispatch(hl.dsp.exec("brave --enable-features=UseOzonePlatform --ozone-platform=wayland")) end)
hl.bind(mod .. " + C", function() hl.dispatch(hl.dsp.exec("qalculate-gtk")) end)
hl.bind(mod .. " + SHIFT + E", function() hl.dispatch(hl.dsp.exec("kitty -e lf")) end)
hl.bind(mod .. " + E", function() hl.dispatch(hl.dsp.exec("thunar")) end)
hl.bind(mod .. " + N", function() hl.dispatch(hl.dsp.exec("kitty -e btop")) end)
hl.bind(mod .. " + O", function() hl.dispatch(hl.dsp.exec("obsidian")) end)
hl.bind(mod .. " + M", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-memento")) end)
hl.bind(mod .. " + I", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-settings")) end)
hl.bind(mod .. " + W", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-winapps")) end)
hl.bind(mod .. " + G", function() hl.dispatch(hl.dsp.exec("dfm")) end)
hl.bind(mod .. " + slash", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-keybinds-toggle")) end)
 
-- Lock screen
hl.bind(mod .. " + Escape", function() hl.dispatch(hl.dsp.exec("hyprlock")) end)
 
-- Navigation (vim keys)
hl.bind(mod .. " + H", function() hl.dispatch(hl.dsp.movefocus("l")) end)
hl.bind(mod .. " + J", function() hl.dispatch(hl.dsp.movefocus("d")) end)
hl.bind(mod .. " + K", function() hl.dispatch(hl.dsp.movefocus("u")) end)
hl.bind(mod .. " + L", function() hl.dispatch(hl.dsp.movefocus("r")) end)
 
hl.bind(mod .. " + SHIFT + H", function() hl.dispatch(hl.dsp.movewindow("l")) end)
hl.bind(mod .. " + SHIFT + J", function() hl.dispatch(hl.dsp.movewindow("d")) end)
hl.bind(mod .. " + SHIFT + K", function() hl.dispatch(hl.dsp.movewindow("u")) end)
hl.bind(mod .. " + SHIFT + L", function() hl.dispatch(hl.dsp.movewindow("r")) end)
 
-- Resize mode
hl.bind(mod .. " + R", function()
  hl.dispatch(hl.dsp.submap("resize"))
end)
 
hl.bind_repeat(" + H", function() hl.dispatch(hl.dsp.resizeactive("-20 0")) end, { submap = "resize" })
hl.bind_repeat(" + J", function() hl.dispatch(hl.dsp.resizeactive("0 20")) end, { submap = "resize" })
hl.bind_repeat(" + K", function() hl.dispatch(hl.dsp.resizeactive("0 -20")) end, { submap = "resize" })
hl.bind_repeat(" + L", function() hl.dispatch(hl.dsp.resizeactive("20 0")) end, { submap = "resize" })
hl.bind(" + Return", function() hl.dispatch(hl.dsp.submap("reset")) end, { submap = "resize" })
hl.bind(" + Escape", function() hl.dispatch(hl.dsp.submap("reset")) end, { submap = "resize" })
 
-- Workspaces (1-0 = workspaces 1-10)
for i = 1, 9 do
  hl.bind(mod .. " + " .. i, function() hl.dispatch(hl.dsp.workspace(i)) end)
  hl.bind(mod .. " + SHIFT + " .. i, function() hl.dispatch(hl.dsp.movetoworkspace(i)) end)
end
hl.bind(mod .. " + 0", function() hl.dispatch(hl.dsp.workspace(10)) end)
hl.bind(mod .. " + SHIFT + 0", function() hl.dispatch(hl.dsp.movetoworkspace(10)) end)
 
-- Mouse binds
hl.bind_mouse(mod .. " + BTN1", function() hl.dispatch(hl.dsp.movewindow()) end)
hl.bind_mouse(mod .. " + BTN2", function() hl.dispatch(hl.dsp.resizewindow()) end)
 
-- Volume
hl.bind_repeat(" + XF86AudioRaiseVolume", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-osd volume-up")) end)
hl.bind_repeat(" + XF86AudioLowerVolume", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-osd volume-down")) end)
hl.bind(" + XF86AudioMute", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-osd volume-mute")) end)
 
-- Brightness
hl.bind_repeat(" + XF86MonBrightnessUp", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-osd brightness-up")) end)
hl.bind_repeat(" + XF86MonBrightnessDown", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-osd brightness-down")) end)
 
-- CapsLock / NumLock — Noctalia's LockKeys widget + OSD render natively.

-- Capture (screenshot + recording)
hl.bind(" + Print", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-capture")) end)
 
-- Clipboard
hl.bind(mod .. " + V", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-clipboard show")) end)
hl.bind(mod .. " + SHIFT + V", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-clipboard pin")) end)
hl.bind(mod .. " + SHIFT + B", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-clipboard clear")) end)
 
-- Stoatools
hl.bind(mod .. " + SHIFT + T", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-ocr")) end)
hl.bind(mod .. " + SHIFT + P", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-paste")) end)
hl.bind(mod .. " + SHIFT + S", function() hl.dispatch(hl.dsp.exec("~/.local/bin/stoa-predict toggle")) end)
 
-- ── Window Rules ──
 
-- Media & Browsers (full opacity)
hl.window_rule({
  match = { class = "brave-browser" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "firefox" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "mpv" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "imv" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "zathura" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "obsidian" },
  opacity = "1.0 override",
})
 
-- Qalculate
hl.window_rule({
  match = { class = "qalculate-gtk" },
  float = true,
  size = { 420, 540 },
  center = true,
})
 
-- Steam
hl.window_rule({
  match = { class = "steam" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "steam", title = "Friends List" },
  float = true,
})
 
hl.window_rule({
  match = { class = "steam", title = "Steam Settings" },
  float = true,
})
 
hl.window_rule({
  match = { class = "steam", title = "Steam" },
  workspace = "9 silent",
})
 
-- Calibre (eBooks)
hl.window_rule({
  match = { class = "calibre" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "calibre-ebook-viewer" },
  opacity = "1.0 override",
})
 
-- YACReader (Comics)
hl.window_rule({
  match = { class = "YACReader" },
  opacity = "1.0 override",
})
 
hl.window_rule({
  match = { class = "YACReaderLibrary" },
  opacity = "1.0 override",
})
 
-- eww Memento Mori
hl.window_rule({
  match = { title = "memento" },
  float = true,
  size = { 860, 580 },
  center = true,
  pin = true,
}) ]]