{
    "theme": {
        "mode": "dark",
        "light": "Stoa",
        "dark": "Stoa"
    },
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 13,
    "buffer_font_features": {
        "calt": true
    },
    "terminal": {
        "font_family": "JetBrains Mono",
        "font_size": 12
    },
    "cursor_blink": true,
    "show_whitespaces": "boundary",
    "minimap": {
        "show": "always"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
