{
    "proxy": "",
    "redact_private_values": true,
    "vim_mode": false,
    "session": {
        "trust_all_worktrees": true
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Zed (Default)"
    },
    "base_keymap": "VSCode",
    "theme": {
        "mode": "dark",
        "light": "Stoa",
        "dark": "Stoa"
    },
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 13,
    "buffer_font_features": {
        "calt": true
    },
    "terminal": {
        "font_family": "JetBrains Mono",
        "font_size": 12
    },
    "cursor_blink": true,
    "show_whitespaces": "boundary",
    "minimap": {
        "show": "always"
    },
    "telemetry": {
        "anthropic_retention": true,
        "diagnostics": true,
        "metrics": true
    }
}
