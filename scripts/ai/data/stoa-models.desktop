[Desktop Entry]
Type=Application
Name=Stoa Models
GenericName=Local LLM chat
Comment=Start the local models (llama.cpp) with web search tools and open the chat
Exec=stoa-models open
Icon=applications-science
Terminal=false
Categories=Utility;
Keywords=llm;llama;ai;chat;models;gguf;
Actions=stop;

[Desktop Action stop]
Name=Stop models
Exec=stoa-models stop
