#!/bin/bash
# Reads the stoa-doctor log and emits a compact JSON status for the
# doctor-pill bar widget.  Called by BarWidget.qml every 60 s.
#
# Output: {"issues": N, "warnings": N}
#   issues == -1  → log file absent (doctor hasn't run yet)

# ── --help ──
case "${1:-}" in
    -h|--help)
        cat <<'STOA_HELP'
stoa-doctor-status — compact JSON status of the last stoa-doctor run (for the doctor pill).

USAGE
  stoa-doctor-status

OUTPUT
  {"issues": N, "warnings": N}      issues == -1 when the log does not exist yet

OPTIONS
  -h, --help    show this help

RESUMO RÁPIDO
  stoa-doctor-status
  stoa-doctor-status -h | --help
STOA_HELP
        exit 0
        ;;
esac

LOG="${XDG_CONFIG_HOME:-$HOME/.config}/stoa/doctor.log"

if [ ! -f "$LOG" ]; then
    echo '{"issues": -1, "warnings": 0}'
    exit 0
fi

issues=$(grep -c '^\[FAIL\]' "$LOG" 2>/dev/null || true)
warnings=$(grep -c '^\[WARN\]' "$LOG" 2>/dev/null || true)

# grep -c returns 1 when no matches; the || true above turns that into
# an empty string on some shells — normalise to 0.
issues=${issues:-0}
warnings=${warnings:-0}

printf '{"issues": %s, "warnings": %s}\n' "$issues" "$warnings"
