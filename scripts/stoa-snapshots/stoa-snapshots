#!/usr/bin/env python3
"""stoa-snapshots — browse package snapshots and config backups.

    stoa-snapshots                    open the browser
    stoa-snapshots --show packages    …on the newest package snapshot
    stoa-snapshots --show configs     …on the newest config backup
    stoa-snapshots summary            JSON for the stoa-health panel (no GTK)
"""

import json
import os
import sys

# Installed as a symlink in ~/.local/bin; the package lives next to the
# real file.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from stoa_snapshots import core  # noqa: E402


def main() -> int:
    if sys.argv[1:2] == ["summary"]:
        print(json.dumps(core.summary()))
        return 0
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    from stoa_snapshots.app import main as app_main
    return app_main(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
