    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#7a7267", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "string.quoted", "string.template"],
            "settings": { "foreground": "#8a9a6c" }
        },
        {
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#6a8a7a" }
        },
        {
            "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
            "settings": { "foreground": "#a89272" }
        },
        {
            "scope": ["constant.language", "constant.language.boolean"],
            "settings": { "foreground": "#c49a5c" }
        },
        {
            "scope": ["constant.other", "variable.other.constant"],
            "settings": { "foreground": "#c4b08a" }
        },
        {
            "scope": ["variable", "variable.other", "variable.parameter"],
            "settings": { "foreground": "#d4cfc4" }
        },
        {
            "scope": ["variable.language", "variable.language.this", "variable.language.self"],
            "settings": { "foreground": "#a89272", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function-call"],
            "settings": { "foreground": "#c49a5c" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
            "settings": { "foreground": "#d4a84b" }
        },
        {
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#c49a5c" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#a89272" }
        },
        {
            "scope": ["entity.other.inherited-class"],
            "settings": { "foreground": "#d4a84b", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.module"],
            "settings": { "foreground": "#c4b08a" }
        },
        {
            "scope": ["keyword", "keyword.control", "keyword.other"],
            "settings": { "foreground": "#c4b08a", "fontStyle": "bold" }
        },
        {
            "scope": ["keyword.operator"],
            "settings": { "foreground": "#9e9a92", "fontStyle": "" }
        },
        {
            "scope": ["keyword.operator.assignment"],
            "settings": { "foreground": "#9e9a92" }
        },
        {
            "scope": ["keyword.operator.logical", "keyword.operator.comparison", "keyword.operator.relational"],
            "settings": { "foreground": "#c4b08a" }
        },
        {
            "scope": ["storage", "storage.type", "storage.modifier"],
            "settings": { "foreground": "#d4a84b" }
        },
        {
            "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.export"],
            "settings": { "foreground": "#5a7a8a" }
        },
        {
            "scope": ["meta.preprocessor", "keyword.control.directive"],
            "settings": { "foreground": "#5a7a8a" }
        },
        {
            "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#9e9a92" }
        },
        {
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#9e9a92" }
        },
        {
            "scope": ["support.constant"],
            "settings": { "foreground": "#c4b08a" }
        },
        {
            "scope": ["support.variable"],
            "settings": { "foreground": "#a89f91" }
        },
        {
            "scope": ["meta.decorator", "punctuation.decorator"],
            "settings": { "foreground": "#c49a5c", "fontStyle": "italic" }
        },
        {
            "scope": ["entity.name.label", "meta.label"],
            "settings": { "foreground": "#d4a84b" }
        },
        {
            "scope": ["markup.heading"],
            "settings": { "foreground": "#c49a5c", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.underline"],
            "settings": { "fontStyle": "underline" }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
            "settings": { "foreground": "#a89272" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#8a9a6c", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.list"],
            "settings": { "foreground": "#c4b08a" }
        },
        {
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#8a9a6c" }
        },
        {
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#b36b5a" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#c49a5c" }
        },
        {
            "scope": ["markup.underline.link"],
            "settings": { "foreground": "#5a7a8a" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#b36b5a", "fontStyle": "bold" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#945a4a", "fontStyle": "italic" }
        },
        {
            "scope": ["meta.diff.header"],
            "settings": { "foreground": "#5a7a8a" }
        },
        {
            "scope": ["source.json string.quoted.double.json meta.structure.dictionary.json support.type.property-name.json"],
            "settings": { "foreground": "#c49a5c" }
        },
        {
            "scope": ["source.css support.type.property-name", "source.scss support.type.property-name"],
            "settings": { "foreground": "#a89f91" }
        },
        {
            "scope": ["source.css constant.other.color", "source.scss variable"],
            "settings": { "foreground": "#c4b08a" }
        },
        {
            "scope": ["source.css entity.other.attribute-name.pseudo-class", "source.css entity.other.attribute-name.pseudo-element"],
            "settings": { "foreground": "#6a8a7a" }
        }
    ],

    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#c49a5c",
        "function.declaration": "#c49a5c",
        "method": "#c49a5c",
        "variable": "#d4cfc4",
        "variable.readonly": "#c4b08a",
        "parameter": "#d4cfc4",
        "property": "#a89f91",
        "property.readonly": "#c4b08a",
        "type": "#d4a84b",
        "class": "#d4a84b",
        "interface": "#d4a84b",
        "enum": "#d4a84b",
        "enumMember": "#c4b08a",
        "namespace": "#c4b08a",
        "decorator": { "foreground": "#c49a5c", "fontStyle": "italic" },
        "macro": "#5a7a8a",
        "string": "#8a9a6c",
        "number": "#a89272",
        "keyword": { "foreground": "#c4b08a", "fontStyle": "bold" },
        "comment": { "foreground": "#7a7267", "fontStyle": "italic" }
    }
}
